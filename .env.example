# Supabase (auth, database, realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# AI provider for turning descriptions into rules (any OpenAI-compatible API)
AI_API_KEY=
# Free option: Google Gemini (key from https://aistudio.google.com/apikey)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash
# Or OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5-mini

# Only needed to run drizzle-kit migrations
# DATABASE_URL=postgres://user:password@host:5432/postgres
